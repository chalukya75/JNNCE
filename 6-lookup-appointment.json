{
  "name": "Lookup Appointment",
  "nodes": [
    {
      "parameters": {},
      "id": "workflow-trigger",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "getMany",
        "calendarId": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "Primary"
        },
        "timeMin": "={{ $json.after_time }}",
        "timeMax": "={{ $json.before_time }}",
        "options": {}
      },
      "id": "get-appointments",
      "name": "Get Appointments",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YOUR_GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter events by email from description\nconst email = $input.item.json.email || $('When called by another workflow').item.json.email;\nconst events = $input.all();\n\nconst filteredEvents = events.filter(event => {\n  const description = event.json.description || '';\n  return description.includes(email);\n});\n\nreturn filteredEvents;"
      },
      "id": "filter-by-email",
      "name": "Filter by Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "value": "Found appointment",
              "type": "string"
            },
            {
              "id": "event-id",
              "name": "event_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "appointment",
              "name": "appointment",
              "value": "={{ $json }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "response",
      "name": "Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [850, 300]
    }
  ],
  "connections": {
    "When called by another workflow": {
      "main": [
        [
          {
            "node": "Get Appointments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Appointments": {
      "main": [
        [
          {
            "node": "Filter by Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter by Email": {
      "main": [
        [
          {
            "node": "Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
