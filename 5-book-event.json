{
  "name": "Book Event",
  "nodes": [
    {
      "parameters": {},
      "id": "workflow-trigger",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "calendarId": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "Primary"
        },
        "start": "={{ $json.start_time }}",
        "end": "={{ $json.end_time }}",
        "summary": "={{ $json.summary }}",
        "options": {
          "description": "Client: {{ $json.email }}"
        }
      },
      "id": "create-calendar-event",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "YOUR_GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "sheetName": "Appointment Log",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Event ID": "={{ $json.id }}",
            "Email": "={{ $('When called by another workflow').item.json.email }}",
            "Type": "={{ $('When called by another workflow').item.json.summary }}",
            "Date": "={{ $json.start.dateTime }}",
            "Notes": "Appointment booked"
          }
        },
        "options": {}
      },
      "id": "log-appointment",
      "name": "Log Appointment",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [650, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "value": "Appointment successfully booked",
              "type": "string"
            },
            {
              "id": "event-id",
              "name": "event_id",
              "value": "={{ $('Create Calendar Event').item.json.id }}",
              "type": "string"
            },
            {
              "id": "event-details",
              "name": "event_details",
              "value": "={{ $('Create Calendar Event').item.json }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "response",
      "name": "Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [850, 300]
    }
  ],
  "connections": {
    "When called by another workflow": {
      "main": [
        [
          {
            "node": "Create Calendar Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Calendar Event": {
      "main": [
        [
          {
            "node": "Log Appointment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Appointment": {
      "main": [
        [
          {
            "node": "Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
