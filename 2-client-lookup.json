{
  "name": "Client Lookup",
  "nodes": [
    {
      "parameters": {},
      "id": "workflow-trigger",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "sheetName": "Clients",
        "filters": {
          "values": [
            {
              "column": "Email",
              "condition": "equals",
              "value": "={{ $json.email }}"
            }
          ]
        },
        "options": {}
      },
      "id": "lookup-in-crm",
      "name": "Lookup in CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [450, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-if-exists",
      "name": "Check if Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "sheetName": "Appointment Log",
        "filters": {
          "values": [
            {
              "column": "Email",
              "condition": "equals",
              "value": "={{ $json.Email }}"
            }
          ]
        },
        "options": {}
      },
      "id": "check-appointments",
      "name": "Check Appointments",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [850, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-appointments",
      "name": "Has Appointments?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "response-message",
              "name": "message",
              "value": "Client exists in CRM. Previous appointments: {{ $json }}",
              "type": "string"
            },
            {
              "id": "client-data",
              "name": "client_data",
              "value": "={{ $('Lookup in CRM').item.json }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "client-with-appointments",
      "name": "Client with Appointments",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1250, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "response-message",
              "name": "message",
              "value": "Client exists in CRM but has no previous appointments.",
              "type": "string"
            },
            {
              "id": "client-data",
              "name": "client_data",
              "value": "={{ $('Lookup in CRM').item.json }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "client-no-appointments",
      "name": "Client No Appointments",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "response-message",
              "name": "message",
              "value": "This is a new client. They don't exist in the CRM.",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ $('When called by another workflow').item.json.email }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "new-client",
      "name": "New Client",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [850, 400]
    }
  ],
  "connections": {
    "When called by another workflow": {
      "main": [
        [
          {
            "node": "Lookup in CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lookup in CRM": {
      "main": [
        [
          {
            "node": "Check if Exists",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check if Exists": {
      "main": [
        [
          {
            "node": "Check Appointments",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "New Client",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Appointments": {
      "main": [
        [
          {
            "node": "Has Appointments?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Appointments?": {
      "main": [
        [
          {
            "node": "Client with Appointments",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Client No Appointments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
